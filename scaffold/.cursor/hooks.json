{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash -c 'exec python3 \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.cursor/hooks/session-start.py\"'",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bash -c 'exec python3 \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.cursor/hooks/deny-dangerous-shell.py\"'",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "bash -c 'exec python3 \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.cursor/hooks/deny-forbidden-paths.py\"'",
        "matcher": "Write|Edit|TabWrite",
        "failClosed": true
      }
    ]
  }
}
