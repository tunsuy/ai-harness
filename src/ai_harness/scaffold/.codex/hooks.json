{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .cursor/hooks/session-start.py",
            "timeout": 5,
            "statusMessage": "harness session bootstrap"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .cursor/hooks/deny-dangerous-shell.py",
            "statusMessage": "shell policy"
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .cursor/hooks/deny-forbidden-paths.py",
            "statusMessage": "path policy"
          }
        ]
      }
    ]
  }
}
